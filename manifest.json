{
  "manifest_version": 3,
  "name": "WhatsApp AI Assistant",
  "version": "1.0.0",
  "description": "Assistente local-first de escrita com IA para WhatsApp Web. BYOK: cada usuário usa sua própria chave da OpenAI.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "src/whatsapp/page-bridge-main.js"
      ]
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "run_at": "document_idle",
      "js": [
        "dist/content-script.js",
        "dist/media-viewer-guard.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/*.js",
        "src/whatsapp/*.js",
        "src/ai/*.js",
        "src/storage/*.js"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ]
}
